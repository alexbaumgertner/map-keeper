# Database
DATABASE_URL=postgresql://user:pass@host/mapkeeper?sslmode=require

# OSM OAuth (register against https://master.apis.dev.openstreetmap.org/ for local)
# Redirect URI must be http://127.0.0.1:3000/api/v1/auth/osm/callback (not localhost)
OSM_API_BASE=https://master.apis.dev.openstreetmap.org
OSM_OAUTH_CLIENT_ID=
OSM_OAUTH_CLIENT_SECRET=
OSM_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/osm/callback

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Discovery
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional geocoding (never use public Nominatim in product)
# LOCATIONIQ_API_KEY=
# PHOTON_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=Mapkeeper <noreply@example.com>

# Tiles
PROTOMAPS_URL=

# Feature flags
FEATURE_GBP=false

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
